{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "automerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.kt$/"],
      "matchStrings": [
        "// renovate: datasource=(?<datasource>docker)\\s+\"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Don't propose major updates to minimum supported PostgreSQL version",
      "matchDatasources": ["docker"],
      "matchDepNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "commitMessageAction": "Update lock file"
  }
}
